<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>TestTrailer</AssemblyName>
    <RootNamespace>TestTrailer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- MelonLoader's NuGet deps are compile-time only here; the game supplies the real ones -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <NoWarn>$(NoWarn);NU1603;NU1701</NoWarn>
    <!-- Interop assemblies generated by MelonLoader on the player's machine (not committed) -->
    <Il2CppAssemblies>$(MSBuildThisFileDirectory)../../ref/Il2CppAssemblies</Il2CppAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Authors' trailer bodies baked by tools/bake_model.py (spec 11) -->
    <EmbeddedResource Include="Models/*.bin" LogicalName="TestTrailer.Models.%(Filename).bin" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(Il2CppAssemblies)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Il2CppFusion.Runtime.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Il2CppFusion.Addons.Physics.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Il2CppPhoton.Realtime.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Il2CppPhotonClient.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Il2CppFusion.Common.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Il2CppFusion.Sockets.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Il2CppFusion.Realtime.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Il2CppFunselektor.FunCore.Runtime.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Il2CppFMODUnity.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Il2CppOccaSoftware.Buto.Runtime.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Unity.RenderPipelines.Core.Runtime.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/UnityEngine.TerrainPhysicsModule.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/UnityEngine.TerrainModule.dll" Private="false" />
  </ItemGroup>

</Project>
